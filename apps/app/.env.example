# Convex (written by `bun run setup` for your dev deployment)
NEXT_PUBLIC_CONVEX_URL=

# Sentry (optional; without a DSN no error reports are sent)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Cloudflare Turnstile (optional; set with TURNSTILE_SECRET_KEY on Convex to
# check for bots before a sign-in code is emailed)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
